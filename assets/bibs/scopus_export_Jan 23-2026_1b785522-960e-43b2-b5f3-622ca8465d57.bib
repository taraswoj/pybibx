@CONFERENCE{Sun20241357,
	author = {Sun, Ge and Zhang, Rui and Xia, Peng and Xu, Jingwen},
	title = {AGV Path Planning Algorithm Based on Improved DQN},
	year = {2024},
	pages = {1357 - 1361},
	doi = {10.1109/ICIBA62489.2024.10868208},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85219090301&doi=10.1109%2FICIBA62489.2024.10868208&partnerID=40&md5=b390bec42e351cfd99307d27d892cc3e},
	affiliations = {TianJin University of Technology and Education, School of Automobile and Transportation, Tianjin, China; Ltd, Tianjin, Tianjin, China},
	abstract = {In the context of rapid growth in the logistics and e-commerce industries, improving the efficiency of automated warehousing systems, particularly in sorting and throughput, has become crucial. Automated guided vehicles (AGVs) have increasingly replaced human workers in handling and sorting tasks, leading to significant improvements in efficiency and accuracy. Path planning, a core AGV technology, plays a vital role in optimizing logistics operations and reducing transportation costs. Common path planning algorithms, such as Dijkstra and A*, each have strengths and limitations. While Dijkstra's algorithm guarantees finding the shortest path by exploring all possible nodes, it suffers from high time and space complexity. A*, though more efficient, sometimes compromises optimality by neglecting certain nodes. Current algorithms overlook the impact of excessive turns, which increases travel time. Deep reinforcement learning (DRL), by combining deep learning and reinforcement learning, offers a promising solution to path planning in dynamic, complex environments. DRL can make intelligent decisions without pre-constructed maps, adapting to the environment through training. In this paper, an improved DQN-based algorithm for AGV path planning is proposed, introducing the concepts of a turning factor and a smoothness factor to address the time cost of turns. By enhancing DQN's state and reward design, the algorithm minimizes the number of turns while maintaining the shortest possible path. Experimental results demonstrate that this approach outperforms traditional A*, modified A*, and standard DQN algorithms, reducing transport time by approximately 21.3% compared to the best-performing baseline, the improved A∗ algorithm. © 2024 IEEE.},
	author_keywords = {Automated Guided Vehicles; Deep Reinforcement Learning; Robotic Mobile Fulfillment Systems},
	keywords = {Automatic guided vehicles; Motion planning; Reinforcement learning; Robot programming; Travel time; Automated guided vehicles; E- commerces; Path-planning algorithm; Rapid growth; Reinforcement learnings; Robotic mobile fulfillment system; Vehicle path planning; Vehicle technology; Warehousing systems; Workers'; Deep reinforcement learning},
	correspondence_address = {R. Zhang; Tianjin University of Technology and Education, School of Automobile and Transportation, Tianjin, China; email: zhangrui318@163.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9798350363586},
	language = {English},
	abbrev_source_title = {Proc. IEEE Int. Conf. Inf. Technol., Big Data Artif. Intell., ICIBA},
