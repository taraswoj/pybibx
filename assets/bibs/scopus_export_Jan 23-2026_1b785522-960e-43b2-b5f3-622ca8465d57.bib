	affiliations = {Universität Stuttgart, Institute of Industrial Automation and Software Engineering, Stuttgart, Baden-Wurttemberg, Germany; Pannon Egyetem, Veszprem, Veszprém, Hungary; Sunstone-RTLS Ltd., Budapest, Hungary; NAiSE GmbH, Stuttgart, Germany},
