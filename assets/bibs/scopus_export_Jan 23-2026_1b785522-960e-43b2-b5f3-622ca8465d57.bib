@CONFERENCE{Gupta2024,
	author = {Gupta, Rishi and Kant, Surya and Singh, Shubhang and Kala, Rahul and Nandi, G. C.},
	title = {Integrated Batching, Pick Sequencing and Robot Assignment for Robotic Warehouse Automation},
	year = {2024},
	pages = {},
	doi = {10.1109/CICT64037.2024.10899742},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000809852&doi=10.1109%2FCICT64037.2024.10899742&partnerID=40&md5=4a8d85f65b606b1d2071d6bb9481d8db},
	affiliations = {Indian Institute of Information Technology, Allahabad, Center of Intelligent Robotics, Prayagraj, UP, India; ABV-Indian Institute of Information Technology and Management, Center for Autonomous Systems, Gwalior, MP, India},
	abstract = {Future warehouses will see robots autonomously picking up all the items ordered by the user and delivering them for packaging, sorting and delivery. This requires warehouses to schedule the robots to autonomously cater to all customer orders. In this paper, we solve the problem of batching orders, where several user orders are clubbed into one to be collectively picked by one robot, scheduling the visit of the robot to pick up the desired items and assigning one robot to carry the operation. Each robot is assumed to have a small payload capacity that restricts the number of orders that can be batched. Each item is assumed to be found at several locations, and the robot can select anyone of the locations. The proposed solution uses heuristics to create initial batches that are further optimised by using Genetic Algorithm. Genetic Algorithm also jointly optimises the batching and item pick sequencing. The selection of one out of several sites is done by using a Dynamic Programming approach. The solution is post processed by using a Dynamic Programming solution for optimally scheduling the robot visits within every batch. The experimental results show that the proposed solution scales to a large number of orders because of the use of heuristics, while the results are better than the use of greedy heuristic approaches. © 2024 IEEE.},
	author_keywords = {genetic algorithm; optimization; scheduling; travelling salesman problem; Warehouse robotics},
	keywords = {Heuristic methods; Heuristic programming; Industrial robots; Robot applications; Robot programming; Scheduling algorithms; Traveling salesman problem; Customer orders; Optimisations; Pay load capacity; Picking up; Programming solutions; Salesman problem; Travelling salesman; User orderings; Warehouse automation; Warehouse robotic; Dynamic programming},
