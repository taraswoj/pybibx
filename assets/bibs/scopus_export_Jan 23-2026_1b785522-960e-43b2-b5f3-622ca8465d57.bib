	pages = {},
	doi = {10.3390/app11135959},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113712539&doi=10.3390%2Fapp11135959&partnerID=40&md5=b635b414055ce6f5705f33b7f70b3206},
	affiliations = {Università di Parma, Department of Engineering and Architecture, Parma, PR, Italy; Alma Mater Studiorum Università di Bologna, Department of Industrial Engineering (DIN), Bologna, BO, Italy; University of Ferrara, Department of Engineering, Ferrara, FE, Italy; Alma Mater Studiorum Università di Bologna, Department of Electrical, Bologna, BO, Italy; Università degli Studi di Modena e Reggio Emilia, Department of Sciences and Methods for Engineering (DISMI), Modena, MO, Italy; Università di Parma, Center for Energy and Environment (CIDEA), Parma, PR, Italy},
	abstract = {This paper presents a mobile manipulation platform designed for autonomous depalletizing tasks. The proposed solution integrates machine vision, control and mechanical components to increase flexibility and ease of deployment in industrial environments such as warehouses. A collaborative robot mounted on a mobile base is proposed, equipped with a simple manipulation tool and a 3D in-hand vision system that detects parcel boxes on a pallet, and that pulls them one by one on the mobile base for transportation. The robot setup allows to avoid the cumbersome implementation of pick-and-place operations, since it does not require lifting the boxes. The 3D vision system is used to provide an initial estimation of the pose of the boxes on the top layer of the pallet, and to accurately detect the separation between the boxes for manipulation. Force measurement provided by the robot together with admittance control are exploited to verify the correct execution of the manipulation task. The proposed system was implemented and tested in a simplified laboratory scenario and the results of experimental trials are reported. © 2021 by the authors. Licensee MDPI, Basel, Switzerland.},
