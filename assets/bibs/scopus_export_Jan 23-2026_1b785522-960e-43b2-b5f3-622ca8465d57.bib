	doi = {10.1109/CSE-EUC.2017.150},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85034649920&doi=10.1109%2FCSE-EUC.2017.150&partnerID=40&md5=976065deb3896eab2e476772d04aaa1a},
	affiliations = {Beijing Wuzi University, Graduate School, Beijing, China; University College Dublin, School of Mathematics and Statistics, Dublin, Leinster, Ireland},
	abstract = {With the country's rapid economic development, as well as the growing shortage of land resources, many Chinese enterprises (especially manufacturers and distributors) would like to optimize their inventory capacity rate in the limited space they have available. The integration of storage with other processes is the key step in achieving the efficient sorting of goods and their warehousing; however, in conventional distribution models a stock cache is set up to allow sorting before storage in a warehouse, this has served, to date, to reduce the distribution chain and improve warehouse capacity. Implementing new 'intensive' warehouse integration technology would improve the automation level, upgrade logistics efficiency, improve warehouse capacity and save on the land area needed by warehouses. In particular, current logistics centers in the tobacco industry have not performed well in using limited warehouse capacity; consequently this industry is very interested in adopting the new technology. The application of an intensive storage integration system to a cigarette logistics center can reduce the number of stages in cigarette distribution from production to sale, for example, it can remove the need for a stock cache. Also, through the full application of automation equipment, this technology can greatly reduce the number of personnel that cigarette logistics centers and their warehouses need, thus improving efficiency and making the industry more economical. The automatic storage integrated library system built with intensive storage integration technology can achieve full real-time quantitative and digital management of cigarette storage, thus meeting, in particular, the demand for increased storage capacity. © 2017 IEEE.},
	author_keywords = {application; intensive storage integration; tobacco},
	keywords = {Applications; Digital libraries; Efficiency; Integration; Internet of things; Personnel; Tobacco; Ubiquitous computing; Warehouses; Automation equipment; Distribution models; Economic development; Improving efficiency; Integrated library systems; Integration technologies; Limited warehouse capacity; Logistics efficiency; Distribution of goods},
