@ARTICLE{Liu20241,
	author = {Liu, Mengting and Qiao, Yan and Wu, Naiqi},
	title = {Efficient Multi-AGV Real-time Collaborative Operation in Large-scale Intelligent Warehouses},
	year = {2024},
	journal = {IEEE Transactions on Intelligent Vehicles},
	pages = {1 - 16},
	doi = {10.1109/TIV.2024.3370763},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186992348&doi=10.1109%2FTIV.2024.3370763&partnerID=40&md5=d06669ae49bfdcdb10c08a0476f55ed3},
	affiliations = {Macau University of Science and Technology, Collaborative Laboratory for Intelligent Science and Systems, Taipa, Macao},
	abstract = {Nowadays, large warehouses operate in an unmanned way by using automated guided vehicles (AGVs). In such a system, large number of AGVs perform their transportation tasks concurrently, leading to high probability of conflicts. It is very challenging to manage the operations of these AGVs. This paper studies the operation problem of a warehouse where an unloaded AGV can travel under the shelves, which is different from the ones studied in the literature. In this paper, the problem is described by a graphic model. Based on the model, we propose a multi-AGV real-time collaborative operation (MARTCO) method. By this method, each AGV operates autonomously and determines its traveling path itself. We design a number of priority rules and an improved A&#x002A; algorithm. The AGVs collaborate by applying these rules. Each AGV can dynamically adjust its path by using MARTCO to avoid conflicts. In this way, the method is computationally efficient such that it can deal with the operation of warehouses with more than 100 AGVs. Also, with the improved A&#x002A; algorithm, the number of returns and nodes to be searched is significantly reduced, which improves the throughput of the system. Large number of experiments are done to verify the proposed method. IEEE},
	author_keywords = {automated guided vehicles (AGV); Collaboration; collaborative dynamic path routing; Heuristic algorithms; Intelligent warehouse; Path planning; Real-time systems; Task analysis; Throughput; Vehicle dynamics},
	keywords = {Automatic guided vehicles; Heuristic algorithms; Interactive computer systems; Job analysis; Motion planning; Throughput; Warehouses; Automated guided vehicle; Automated guided vehicles; Collaboration; Collaborative dynamic path routing; Dynamic paths; Heuristics algorithm; Intelligent warehouse; Path routing; Real - Time system; Task analysis; Vehicle's dynamics; Real time systems},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
