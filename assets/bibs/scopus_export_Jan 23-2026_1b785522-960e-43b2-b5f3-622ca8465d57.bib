	year = {2023},
	pages = {1490 - 1495},
	doi = {10.1109/CAC59555.2023.10451439},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189361975&doi=10.1109%2FCAC59555.2023.10451439&partnerID=40&md5=9e27458ad70accf95bf8979ebf86ccda},
	affiliations = {Huazhong University of Science and Technology, School of Artificial Intelligence and Automation, Wuhan, Hubei, China; Huazhong University of Science and Technology, Wuhan, Hubei, China},
	abstract = {In recent years, the problem of task assignment and path planning for multiple agents in automated warehouses, known as Task Assignment and Muti-agent Path Finding (TAPF) problem, has gained increasing attention. The TAPF problem aims to find task assignments and conflict-free path plans for agents while optimizing the objective function. However, existing algorithms are not well-suited to solve the TAPF problem in large-scale and densely populated environments while ensuring optimality. In this paper, we propose the Add Heuristics to Conflict-Based Search with Task Assignment (CBSH-TA) algorithm as an extension of the CBS-TA algorithm. Our algorithm introduces several key enhancements: 1) classifying conflict types and prioritizing conflicts, 2) incorporating heuristics into task assignment to expedite the search for optimal assignments, and 3) integrating CG, DG, and WDG heuristics into the high-level search process. We compare the proposed algorithm with the CBS-TA algorithm on maps of different sizes and densities. Experimental results demonstrate that CBSH - TA significantly reduces the number of expanded nodes, decreases runtime, and requires less memory, making it suitable for large-scale and densely populated environments. © 2023 IEEE.},
	author_keywords = {autonomous warehouse; heuristic; muti-agent path finding; task assignment},
	keywords = {Autonomous agents; Electric circuit breakers; Multi agent systems; Optimization; Warehouses; Automatic warehouse; Autonomous warehouse; Heuristic; Large-scales; Multi agent; Multiple agents; Muti-agent path finding; Path finding; Path finding problems; Tasks assignments; Motion planning},
