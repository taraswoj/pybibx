	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001375099&doi=10.1109%2FRICAI64321.2024.10911467&partnerID=40&md5=3a52e108106d99658657f0d1598e87fa},
	affiliations = {State Grid Shandong Electric Power Company Material Company, China},
	abstract = {With the increasing application of UAVs in intelligent warehouses, how to solve the problem of path planning in complex environments, especially multi-objective path planning and obstacle avoidance, has become a key challenge. In this paper, A 3D path planning method based on A* algorithm and B spline curve is proposed to optimize the automatic inventory path of UAVs. Firstly, the traditional path planning algorithm is optimized by introducing Angle cost to reduce unnecessary turns and improve flight stability and energy efficiency. Secondly, a multi-objective path optimization strategy is proposed to ensure the shortest path and reduce inventory time and energy consumption by automatically adjusting the order of target points. At the same time, B-spline curve is used to smooth the path, eliminate sharp turns, and improve flight smoothness. The experimental results verify the effectiveness and robustness of the proposed method in complex three-dimensional environment, which can avoid obstacles, optimize paths, and achieve higher inventory efficiency in multi-objective point planning, and has strong practical application value. © 2024 IEEE.},
