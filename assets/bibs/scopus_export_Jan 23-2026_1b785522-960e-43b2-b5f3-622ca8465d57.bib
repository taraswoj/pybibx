@ARTICLE{Street2024393,
	author = {Street, Charlie and Jujjavarapu, Sri Sadhan and Chen, Michael Nai An and Paul, Sanjoy and Hawes, Nick},
	title = {Analysing the Effects of Congestion on Hybrid Order Picking Systems Using a Discrete-Event Simulator},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
	volume = {795},
	pages = {393 - 404},
	doi = {10.1007/978-3-031-44851-5_30},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85192435355&doi=10.1007%2F978-3-031-44851-5_30&partnerID=40&md5=8cf050a1b415aaebef6576f2102ea958},
	affiliations = {University of Birmingham, Birmingham, West Midlands, United Kingdom; Accenture, Chicago, IL, United States; University of Oxford, Oxford, Oxfordshire, United Kingdom},
	abstract = {In hybrid order-picking systems (OPSs), human workers collaborate alongside autonomous guided vehicles (AGVs) to pick up and transport items in a warehouse. Congestion occurs when multiple humans and AGVs operate in an area simultaneously. Congestion decreases AGV navigation performance and may cause queuing delays at packing stations. In this paper, we study the impact of congestion on the performance of hybrid OPSs. We simulate a hybrid OPS using a discrete-event simulator and evaluate the throughput under different levels of congestion and the number of AGVs. Using 10 AGVs under no congestion, we observe a throughput increase of 105% compared to a manual OPS with zero AGVs. However, this improvement decreases as the effects of congestion become stronger. Under our heaviest congestion model, there was only a 3% throughput increase for 10 AGVs. We also analyse the economic impact of adding AGVs to a hybrid OPS. Under medium congestion, the optimal number of AGVs for maximising long-term profit is 20. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
	keywords = {Automatic guided vehicles; Discrete event simulation; Materials handling; Autonomous guided vehicles; Congestion models; Discrete-event simulators; Hybrid orderings; Navigation performance; Order-picking systems; Queuing delay; Vehicle navigation; Workers'; Warehouses},
	correspondence_address = {N. Hawes; Oxford Robotics Institute, University of Oxford, Oxford, United Kingdom; email: nickh@robots.ox.ac.uk},
	editor = {Lee, S.-G. and An, J. and Chong, N.Y. and Strand, M. and Kim, J.H.},
