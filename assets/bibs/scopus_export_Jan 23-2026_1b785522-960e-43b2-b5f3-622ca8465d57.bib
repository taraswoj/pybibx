	abbrev_source_title = {Transp. Policy},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Green Accepted Open Access; Green Open Access}
}

@ARTICLE{Alajami2025,
	author = {Alajami, Abdussalam A.A. and Pous, Rafael},
