	year = {2022},
	pages = {253 - 258},
	doi = {10.1109/ROBIO55434.2022.10011784},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85147330666&doi=10.1109%2FROBIO55434.2022.10011784&partnerID=40&md5=4ec2cc390f309c129b91f4aede92d0bb},
	affiliations = {Harbin Institute of Technology Shenzhen, Department of Control Science and Engineering, Shenzhen, Guangdong, China},
	abstract = {In automated warehouses, the battery management strategy of Automated Guided Vehicles (AGVs) can affect the throughput and operational efficiency of the warehouse. In this paper, we first model the battery management problem as a Markov Decision Process (MDP) and adopt the deep reinforcement learning (DRL) algorithm as the battery management strategy. However, discounted reward DRL algorithms ignore long-term benefits, which are not suitable for the strategy since orders arriving at the warehouse at every moment are important and should be treated. In order to solve the above problems, we then introduce the average reward DRL algorithm to focus more on long-term benefits. But the existing average reward DRL algorithms have the problems of low sample utilization and unstable training. Therefore, we present a practical algorithm called average reward TD3 (ARTD3) that learns faster and is more stable. Finally, we conduct extensive experiments to confirm that ARTD3 outperforms discounted reward DRL algorithm and rule-based methods. © 2022 IEEE.},
	author_keywords = {Automated Warehouses; Average-Reward Reinforcement Learning; Battery Management},
	keywords = {Automatic guided vehicles; Automation; Battery management systems; Deep learning; Markov processes; Warehouses; Automated guided vehicles; Automated warehouse; Average reward; Average-reward reinforcement learning; Battery Management; Discounted reward; Management strategies; Reinforcement learning algorithms; Reinforcement learnings; Throughput efficiency; Reinforcement learning},
	correspondence_address = {Y. Li; Harbin Institute of Technology (Shenzhen), Department of Control Science and Engineering, Shenzhen, China; email: autolyj@hit.edu.cn},
