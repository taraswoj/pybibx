	keywords = {Automatic guided vehicles; Cost effectiveness; Electronic data interchange; Embedded systems; Information management; Mobile robots; Online systems; Real time systems; Virtual reality; Warehouses; Automated guided vehicles; Cybe-physical systems; Cyber-physical systems; Data-communication; EtherCAT; Logistic management; Operation management; Robot kinematics; Warehouse management; Wearable devices; Cyber Physical System},
