	keywords = {Decision making; Discrete event simulation; Distributed computer systems; Economic and social effects; Equipment; Investments; Materials handling; Materials handling equipment; Sales; Supply chains; Warehouses; Automated distribution; Characteristic curve; Distribution centers; Investment decisions; Investment evaluation; Operational issues; Retail supply chain; Warehouse automation; Automation},
