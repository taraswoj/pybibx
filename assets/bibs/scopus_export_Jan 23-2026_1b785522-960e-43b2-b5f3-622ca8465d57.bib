@ARTICLE{Yang2025,
	author = {Yang, Shuo and Song, Shuai and Song, Ran and Cheng, Jiyu and Li, Yibin and Zhang, Wei},
	title = {Learning packing-and-unpacking synergistic policy via LLM-guided DRL for robust online robotic packing},
	year = {2025},
	journal = {Advanced Engineering Informatics},
	volume = {68},
	pages = {},
	doi = {10.1016/j.aei.2025.103572},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009094697&doi=10.1016%2Fj.aei.2025.103572&partnerID=40&md5=fd48460e9578b4db4529661134bdef35},
	affiliations = {Qilu Hospital of Shandong University, Department of Urology, Jinan, Shandong, China; Shandong University, Jinan, Shandong, China},
	abstract = {Online robotic packing facilitates various applications within the logistics industry, attracting increasing attentions of developing robotic packing system for logistic scenarios. Typically, the online robotic packing aims to pick items one by one and then pack them into a container with as high space utilization as possible. In most studies, the online robotic packing is modeled as an Online 3D Bin Packing Problem (3D-BPP), which is notoriously NP-hard due to the online setting that only the current item is observable. Currently, the heuristic methods and deep reinforcement learning (DRL) methods are two primary approaches for online 3D-BPP. Nonetheless, these methods are still inferior to human packers when finishing packing tasks in logistics applications. One important reason is that humans have the ability to correct mistakes: when some items have not been packed appropriately, human packers will unpack them from the container and then arrange these items in more reasonable positions. Motivated by the unpacking experience of human packers, we rethink the pipeline for online 3D-BPP and present a packing-and-unpacking synergistic network (PUSNet) that integrates DRL and large language model (LLM) guidances. Through extensive experiments, PUSNet is demonstrated the state-of-the-art robotic packing pipeline. Moreover, the robotic packing system built upon PUSNet exhibits reliable packing performance in real-world logistics scenarios, in terms of both the space utilization and packing stability. © 2025 Elsevier Ltd},
	author_keywords = {Deep reinforcement learning; Large Language Model; Online 3D-BPP; Robotic packing; Warehouse Automation},
	keywords = {3D modeling; Containers; Deep learning; Deep reinforcement learning; Logistics; Packers; Packing; Pipelines; Reinforcement learning; Robotics; Bin packing problem; Language model; Large language model; Online 3d bin packing problem; Online robotics; Packing systems; Reinforcement learnings; Robotic packing; Space utilization; Warehouse automation; Heuristic methods},
	correspondence_address = {W. Zhang; School of Control Science and Engineering, Shandong University, Jinan, China; email: davidzhang@sdu.edu.cn},
	publisher = {Elsevier Ltd},
	issn = {14740346},
	language = {English},
	abbrev_source_title = {Adv. Eng. Inf.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

