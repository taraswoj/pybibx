@CONFERENCE{Ma20161144,
	author = {Ma, Hang and Koenig, Sven A.},
	title = {Optimal target assignment and path finding for teams of agents},
	year = {2016},
	journal = {Proceedings of the International Joint Conference on Autonomous Agents and Multiagent Systems, AAMAS},
	pages = {1144 - 1152},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85014303475&partnerID=40&md5=c3ad190eddb765e95f4348e643cf679e},
	affiliations = {USC Viterbi School of Engineering, Los Angeles, CA, United States},
	abstract = {We study the TAPF (combined target-assignment and path-finding) problem for teams of agents in known terrain, which generalizes both the anonymous and non-anonymous multiagent path-finding problems. Each of the teams is given the same number of targets as there are agents in the team. Each agent has to move to exactly one target given to its team such that all targets are visited. The TAPF problem is to first assign agents to targets and then plan collision-free paths for the agents to their targets in a way such that the makespan is minimized. We present the CBM (Conflict-Based Min-Cost-Flow) algorithm, a hierarchical algorithm that solves TAPF instances optimally by combining ideas from anonymous and non-anonymous multi-agent path-finding algorithms. On the low level, CBM uses a min-cost max-flow algorithm on a time-expanded network to assign all agents in a single team to targets and plan their paths. On the high level, CBM uses conflict-based search to resolve collisions among agents in different teams. Theoretically, we prove that CBM is correct, complete and optimal. Experimentally, we show the scalability of CBM to TAPF instances with dozens of teams and hundreds of agents and adapt it to a simulated warehouse system. © © 2016, International Foundation for Autonomous Agents and Multiagent Systems (www.ifaamas.org). All rights reserved.},
	author_keywords = {Heuristic search; Kiva (Amazon Robotics) systems; Multi-robot path finding; Multiagent path finding; Network flow; Path planning; Robotics; Target assignment; Team work; Warehouse automation},
