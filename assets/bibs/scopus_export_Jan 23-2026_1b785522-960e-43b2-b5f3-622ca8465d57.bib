}

@CONFERENCE{Yin20242667,
	author = {Yin, Huilin and Su, Shengkai and Lin, Yinjia and Zhen, Pengju and Festl, Karin and Watzenig, Daniel},
	title = {Random Network Distillation Based Deep Reinforcement Learning for AGV Path Planning},
	year = {2024},
	journal = {IEEE Intelligent Vehicles Symposium, Proceedings},
