@ARTICLE{Bortolini2017133,
	author = {Bortolini, Marco and Faccio, Maurizio and Ferrari, Emilio and Gamberi, Mauro and Pilati, Francesco},
	title = {Time and energy optimal unit-load assignment for automatic S/R warehouses},
	year = {2017},
	journal = {International Journal of Production Economics},
	volume = {190},
	pages = {133 - 145},
	doi = {10.1016/j.ijpe.2016.07.024},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84992741420&doi=10.1016%2Fj.ijpe.2016.07.024&partnerID=40&md5=c21910a8600eee3b23b0e27b59e0a854},
	affiliations = {Alma Mater Studiorum Università di Bologna, Department of Industrial Engineering, Bologna, BO, Italy; Università degli Studi di Padova, Department of Management and Engineering, Padua, PD, Italy},
	abstract = {Effectiveness in warehouse design and operations is crucial for the industrial companies to be competitive in the market arena by reducing the response time and inbound costs, increasing their global service level. Storage assignment deals with the definition of effective strategies to organise items into industrial warehouses to achieve high performances. This paper enhances the conventional approaches on storage assignment proposing a time and energy bi-objective model for single-deep rack automatic warehouses served by aisle captive automated storage/retrieval systems (AS/RSs). The model is based on the joint minimisation of the travel time and the energy required by the cranes to S/R the unit-loads. The analytic models to compute the expected single-command cycle time and energy are integrated into a bi-objective model, optimising the load assignment. An application, taken from the beverage industry, is, finally, discussed. The different perspectives of adopting time and energy to drive the load assignment are stressed proposing a practical trade-off rule. Results highlight the possibility to balance the time cycle and the energy intensity. Within the case application, an energy saving of 12.66% respect to the time model occurs with a time efficiency decrease of about 2.52%. © 2016 Elsevier B.V.},
	author_keywords = {Automatic storage/retrieval system; Bi-objective optimisation; Energy model; Green design; Storage assignment; Warehousing},
	keywords = {Beverages; Ecodesign; Economic and social effects; Energy conservation; Travel time; Bi objectives; Energy model; Storage assignment; Storage/retrieval; Warehousing; Warehouses},
	correspondence_address = {M. Gamberi; Department of Industrial Engineering, University of Bologna, Bologna, Viale del Risorgimento 2, 40136, Italy; email: mauro.gamberi@unibo.it},
