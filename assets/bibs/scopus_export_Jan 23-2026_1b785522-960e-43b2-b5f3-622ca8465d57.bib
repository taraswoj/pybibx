	pages = {49 - 54},
	doi = {10.21872/2023IISE_2204},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85189651601&doi=10.21872%2F2023IISE_2204&partnerID=40&md5=fd523b9c27f7ccb6fd44e01097cfe2c8},
	affiliations = {Purdue University, West Lafayette, IN, United States},
	abstract = {Autonomous Mobile Robot (AMR) has been publicly recognized as the upgrade for the comprehensively adopted material handling system Automated Guided Vehicle (AGV). Compared with AGV, the improvements of AMRs in movement flexibility, information connectivity, and resilience to uncertainty provide both advantages and challenges for AMR's fleet management. However, at the current stage of AMR fleet management research, there are gaps between the conceptual framework of AMR intralogistics and its industrial application - the subproblems of AMR Fleet Management are seldomly discussed from an integrated perspective, and the assumptions for motion synchronization and coordination among the fleet of AMRs are unrealistic. Furthermore, most research targets low vehicle-density application scenarios, so particularly challenging applications like Warehouse Intralogistics are not properly addressed. To fill these gaps, we developed a kinetically enabled Simulated-Reality simulator with Unity"to address the specific application of AMR material handling in the reception-to-storage process of retail warehousing systems. In addition, an asynchronous implementation of the pathfinding algorithm and a cluster-based Task Allocation protocol named PNSC was developed and tested in the simulation testbed. With simulation on randomly generated problem sets, we found the proposed fleet management protocol significantly outperformed the commonly adopted protocols regarding hourly throughputs and congestion management. © IISE Annual Conference & Expo 2023. All rights reserved.},
	author_keywords = {AMR; Fleet Management; Intralogistics; Parallelism; Unity Simulation},
	keywords = {Automatic guided vehicles; Fleet operations; Industrial research; Testbeds; Warehouses; Automated guided vehicles; Autonomous Mobile Robot; Fleet management; Intralogistic; Management protocols; Materials handling systems; Parallelism; Simulation test beds; Uncertainty; Unity simulation; Materials handling},
