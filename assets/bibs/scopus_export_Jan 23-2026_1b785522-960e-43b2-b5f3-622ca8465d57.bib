	doi = {10.1016/j.ifacol.2015.06.239},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84953878654&doi=10.1016%2Fj.ifacol.2015.06.239&partnerID=40&md5=0e29578dcde6772c6cf0bfb53174ebe0},
	affiliations = {Izmir Ekonomi Üniversitesi, Department of Industrial Engineering, Izmir, Turkey; Université Abou Bekr Belkaid Tlemcen, Manufacturing Engineering Laboratory of Tlemcen, Tlemcen, Tlemcen Province, Algeria; Univerza v Mariboru, Faculty of Mechanical Engineering, Maribor, Slovenia},
	abstract = {In this study, we aim to find out the best rack design for shuttle-based storage and retrieval system (SBS/RS) under class-based storage policy (CSP). SBS/RS is a new technology in automated storage and retrieval system (AS/RS) which is developed for high transaction environments where mini-load AS/RS crane may not be able to keep pace with the transaction rate needed over a given number of storage locations. We consider several rack design concepts in terms of number of aisles, tiers and bays in the warehouse. The performance of the system is evaluated in terms of utilizations of lifts and storage/retrieval devices and cycle times of storage/retrieval transactions. We utilize simulation for the modeling purpose. The results indicate that CSP works better under high rise warehouse design. So, this may create less number of lifts requirement in the system. Hence, the warehouse design with CSP may tend to have lower investment cost. By this study, we also aim to provide practitioners and academia a significant insight for SBS/RS design under several rack design concepts for CSP. © 2015, IFAC (International Federation of Automatic Control) Hosting by Elsevier Ltd. All rights reserved.},
	author_keywords = {Automated storage and retrieval system; Automated warehouse; Class-based storage; SBS/RS; Simulation},
	keywords = {Automation; Computer control systems; Information retrieval; Warehouses; Automated storage and retrieval system; Automated warehouse; Class based storage; Simulation; Storage and retrievals; Storage location; Storage/retrieval; Transaction rates; simulation; Warehouse design; Design},
