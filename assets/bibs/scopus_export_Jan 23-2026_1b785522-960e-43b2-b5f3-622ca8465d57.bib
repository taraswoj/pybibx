@ARTICLE{Pikulin2025,
	author = {Pikulin, Pavlo and Lishunov, Vitalii and Kulakowski, Konrad},
	title = {Optimizing Path Planning for Automated Guided Vehicles in Constrained Warehouse Environments: Addressing the Challenges of Non-Rotary Platforms and Irregular Layouts},
