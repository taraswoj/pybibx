@CONFERENCE{Haryono201661,
	author = {Haryono, Givanna Putri and Zhou, Ying},
	title = {Profiling apache HIVE query from run time logs},
	year = {2016},
	pages = {61 - 68},
	doi = {10.1109/BIGCOMP.2016.7425802},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84964680335&doi=10.1109%2FBIGCOMP.2016.7425802&partnerID=40&md5=fcadfa75b55365a6aa7c69d63feb2e1a},
	affiliations = {School of Computer Science, Sydney, NSW, Australia},
	abstract = {Apache Hive is a widely used data warehousing and analysis tool. Developers write SQL like HIVE queries, which are converted into MapReduce programs to runs on a cluster. Despite its popularity, there is little research on performance comparison and diagnose. Part of the reason is that instrumentation techniques used to monitor execution can not be applied to intermediate MapReduce code generated from Hive query. Because the generated MapReduce code is hidden from developers, run time logs are the only places a developer can get a glimpse of the actual execution. Having an automatic tool to extract information and to generate report from logs is essential to understand the query execution behavior. We designed a tool to build the execution profile of individual Hive queries by extracting information from HIVE and Hadoop logs. The profile consists of detailed information about MapReduce jobs, tasks and attempts belonging to a query. It is stored as a JSON document in MongoDB and can be retrieved to generate reports in charts or tables. We have run several experiments on AWS with TPC-H data sets and queries to demonstrate that our profiling tool is able to assist developers in comparing HIVE queries written in different formats, running on different data sets and configured with different parameters. It is also able to compare tasks/attempts within the same job to diagnose performance issues. © 2016 IEEE.},
	keywords = {Data warehouses; Automatic tools; Extract informations; Extracting information; Instrumentation techniques; Performance comparison; Performance issues; Profiling tools; Query execution; Big data},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {9781467387965},
	language = {English},
	abbrev_source_title = {Int. Conf. Big Data Smart Comput., BigComp},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Vivaldini2016719,
	author = {Vivaldini, Kelen Cristiane Teixeira and Rocha, Luis F. and Martarelli, Nádia Junqueira and Becker, Marcelo and Moreira, António Paulo},
	title = {Integrated tasks assignment and routing for the estimation of the optimal number of AGVS},
	year = {2016},
	journal = {International Journal of Advanced Manufacturing Technology},
	volume = {82},
	number = {1-4},
	pages = {719 - 736},
	doi = {10.1007/s00170-015-7343-4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84953835201&doi=10.1007%2Fs00170-015-7343-4&partnerID=40&md5=c8ab5b64f14fa61e5be60adb8e47afb0},
	affiliations = {Universidade de São Paulo, Mechatronics Group - Mobile Robotics Lab, Sao Paulo, SP, Brazil; Institute for Systems and Computer Engineering, Technology and Science, Porto, Porto, Portugal; Universidade de São Paulo, Mechatronics Group - Mobile Robotics Lab, Sao Paulo, SP, Brazil; Institute for Systems and Computer Engineering, Technology and Science, Porto, Porto, Portugal},
	abstract = {A fundamental problem in the management of an automated guided vehicle system (AGVS) is the determination of the load to be transported and the vehicle to transport it. The time for the loading and unloading of pallets must be specified as soon as possible. Typical objectives are minimization of travel times and costs by the reduction of the number of vehicles required to fulfill a given transportation order. This article presents a methodology for the estimation the minimum number of AGVs (considering all the available ones at the shop floor level) required to execute a given transportation order within a specific time-window. A comparison is made between the algorithms Shortest Job First and meta-heuristic Tabu Search (applied to an initial solution) for a task assignment. An enhanced Dijkstra algorithm is used for the conflict-free routing task. The number of vehicles is estimated so as to provide an efficient distribution of tasks and reduce the operational costs of the materials handling system. Simulation results of two typical industrial warehouse shop floor scenarios are provided. Although the study focuses on pre-planning of order fulfillment of materials handling, the proposed methodology can also be utilized as an important tool for investment analysis of the warehouse layout design and for estimating the ideal number of AGVs. © 2015, Springer-Verlag London.},
	author_keywords = {Automated guided vehicles; Collision avoidance; Routing; Task scheduling},
	keywords = {Collision avoidance; Cost reduction; Floors; Heuristic algorithms; Investments; Materials handling; Materials handling equipment; Mobile robots; Risk assessment; Tabu search; Travel time; Unloading; Vehicles; Warehouses; Automated guided vehicle system; Automated guided vehicles; Dijkstra algorithms; Investment analysis; Loading and unloading; Materials handling systems; Routing; Task-scheduling; Automatic guided vehicles},
	correspondence_address = {K. Vivaldini; EESC-USP, Mechatronics Group - Mobile Robotics Lab, São Carlos, Brazil; email: kteixeira@sc.usp.br},
