@ARTICLE{Draganjac20161433,
	author = {Draganjac, Ivica and Miklić, Damjan and Kovaĉić, Zdenko and Vasiljević, Goran Vasiljevic@fer Hr and Bogdan, Stjepan},
	title = {Decentralized Control of Multi-AGV Systems in Autonomous Warehousing Applications},
	year = {2016},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {13},
	number = {4},
	pages = {1433 - 1447},
	doi = {10.1109/TASE.2016.2603781},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85027065082&doi=10.1109%2FTASE.2016.2603781&partnerID=40&md5=6f4055929a6bb9b19a164d625e910e80},
	affiliations = {University of Zagreb, Faculty of Electrical Engineering and Computing, Department of Control and Computer Engineering, Zagreb, Croatia},
	abstract = {In this paper, we present an algorithm for decentralized control of multiple automated guided vehicles performing transportation tasks within industrial and warehousing environments. By running on each vehicle in the system, the algorithm provides vehicles with capabilities for autonomous path planning and motion co-ordination. The path planning part of the algorithm implements a free-ranging motion scheme by determining the shortest feasible paths considering nonholonomic vehicle constraints. The motion co-ordination part of the algorithm ensures safe vehicle motions by reliable detection and resolution of different conflict situations with other vehicles in the shared workspace. Conflict resolution is based on a vehicle priority scheme and results in temporary stopping or removal of the lower priority vehicles taking part in the conflict. Removal action is always performed within the vehicle's private zone, i.e., the pre-allocated local region of the workspace surrounding the vehicle. By encoding information on the vehicle size and its kinematic constraints, the introduced private zone mechanism provides the necessary physical space required for successful execution of every removal action. We also analyze the stability of the presented algorithm and discuss its deadlock-free and livelock-free properties. Algorithm performance has been validated by simulation using ten vehicles and experimentally on two different setups-a laboratory setup comprising five Pioneer 3DX vehicles and by two state-of-the-art autonomous forklifts in industrial-like operating conditions. © 2017 IEEE.},
	author_keywords = {Decentralized control; flexible manufacturing systems; mobile robots; multi-robot systems; warehousing},
	keywords = {Decentralized control; Flexible manufacturing systems; Intelligent vehicle highway systems; Manufacture; Mobile robots; Motion planning; Multipurpose robots; Vehicle performance; Vehicles; Warehouses; Algorithm performance; Automated guided vehicles; Encoding informations; Kinematic constraints; Multi-robot systems; Nonholonomic vehicles; Operating condition; warehousing; Automatic guided vehicles},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15455955},
	language = {English},
	abbrev_source_title = {IEEE Trans. Autom. Sci. Eng.},
	type = {Article},
	publication_stage = {Final},
