@CONFERENCE{Schwesinger2016274,
	author = {Schwesinger, Dylan and Spletzer, John R.},
	title = {A 3D approach to infrastructure-free localization in large scale warehouse environments},
	year = {2016},
	journal = {IEEE International Conference on Automation Science and Engineering},
	volume = {2016-November},
	pages = {274 - 279},
	doi = {10.1109/COASE.2016.7743418},
