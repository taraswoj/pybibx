@CONFERENCE{Ma20241603,
	author = {Ma, Shendong and Yang, Daoye},
	title = {Research on the Method of Cargo Detection Based on YOLOv7-Tiny},
	year = {2024},
	pages = {1603 - 1607},
	doi = {10.1109/ACAIT63902.2024.11021823},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009082108&doi=10.1109%2FACAIT63902.2024.11021823&partnerID=40&md5=0b614878aa439317a589ffad72e24af0},
	affiliations = {Nanjing Tech University, College of Electrical Engineering and Control Science, Nanjing, Jiangsu, China},
	abstract = {As automation technology advances, cargo classification is becoming increasingly important. Cargo detection is a key application area in computer vision, involving the recognition and positioning of various goods in images or videos. The emergence of Convolutional Neural Networks (CNNs) [1] has brought about a profound change in the approach to object detection. It can automatically learn and extract features from images, making goods detection more accurate and reliable. YOLO [2] is a deep learning model widely used in cargo detection [3]. It is a single-stage object detection algorithm capable of quickly recognizing and locating multiple objects, making it suitable for real-time applications. By improving detection accuracy, YOLO reduces waste in logistics and warehousing processes, optimizes supply chain processes, and lowers carbon emissions and energy consumption. The current mainstream methods for cargo category detection include barcode and QR code recognition, magnetic stripe recognition, and radio frequency identification (RFID) [4]. Utilizing visual detection for precise cargo category detection and automated cargo recognition can lower costs and increase production efficiency. Mainstream visual algorithms are based on deep learning-based object detection methods and are primarily divided into two types: one is the One-Stage algorithm, such as YOLO and SSD; the other is the Two-Stage algorithm, such as RCNN, Faster-RCNN, and Mask-RCNN. The paper proposes a solution for the online detection of cargo categories based on YOLOv7-Tiny. The YOLOv7 backbone network integrates the Scale-Aware RFE module. To further reduce the model's parameter count and increase detection speed, this paper introduces a GSConv-based Slim-neck structure to decrease model complexity while ensuring precision. To optimize model performance and accelerate convergence, the MPDIoU loss function is introduced. The MPDIoU loss function aids in faster convergence, enhances prediction stability, and simplifies the computational process, ultimately improving target localization accuracy.Finally, the model was trained and tested using a dataset. The experimental results indicate that the improved YOLOv7-Tiny model exhibits high precision, low computational load, and fast detection speed, effectively meeting the online detection requirements for cargo. Finally, the average detection accuracy on the custom dataset reached 75.2%, which is an improvement of 4.0% compared to the initial model. Compared to the original model, the detection speed has also improved. © 2024 IEEE.},
	author_keywords = {GSConv; MPDIoU; Scale-Aware RFE; YOLOv7-Tiny},
	keywords = {Bar codes; Computer vision; Convolution; Convolutional neural networks; Deep learning; Learning algorithms; Learning systems; Object detection; Object recognition; Object tracking; Supply chains; Warehouses; Automation technology; Detection accuracy; Detection speed; Gsconv; Loss functions; MPDIoU; On-line detection; Scale-aware RFE; Technology advances; YOLOv7-tiny; Radio frequency identification (RFID)},
	correspondence_address = {S. Ma; Nanjing Tech University, College of Electrical Engineering and Control Science, Nanjing, China; email: 18110924675@163.com},
