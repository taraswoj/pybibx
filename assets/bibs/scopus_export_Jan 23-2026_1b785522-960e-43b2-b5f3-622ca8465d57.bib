}

@CONFERENCE{Khan20241018,
	author = {Khan, Natalia and Arnarson, Halldor and Solvang, Wei Deng and Yu, Hao},
	title = {Time Optimization of Warehouse Operations Through Industry 4.0 Technology Implementation: Case Study from a Spare Parts Warehouse in the Oil and Gas Industry},
	year = {2024},
