@ARTICLE{Chang202446,
	author = {Chang, Yungchia and Chang, Kueihu and Meng, Hsien Mi and Chang, Chihhan},
	title = {INTEGRATING INTEGER PROGRAMMING WITH HEURISTIC ALGORITHM TO SOLVE THE WAREHOUSE RELOCATION PROBLEM OF AUTOMATED STORAGE AND RETRIEVAL SYSTEMS WITH MULTIPLE LOADING DEPOTS},
	year = {2024},
	journal = {International Journal of Industrial Engineering : Theory Applications and Practice},
	volume = {31},
	number = {1},
	pages = {46 - 64},
	doi = {10.23055/ijietap.2024.31.1.8755},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85185881710&doi=10.23055%2Fijietap.2024.31.1.8755&partnerID=40&md5=d580c51492d260402deff623a87e54b9},
	affiliations = {National Yang Ming Chiao Tung University, Hsinchu, Taiwan; Chinese Military Academy Taiwan, Feng Shan, Kaohsiung, Taiwan; Feng Chia University, Taichung, Taiwan},
	abstract = {The primary focus of the warehouse relocation problem is to systematically and efficiently move items already stored in the warehouse to newly planned storage locations, which is a critical issue for the successful operation of Automated Storage and Retrieval Systems (AS/RS). There is limited research on the warehouse relocation problem for AS/RS with multiple loading and unloading stations. To address this issue, this research proposed an approach to rearrange the materials stored in a unit-load AS/RS with multiple loading stations to a target assignment. A mathematical model based on integer programming was built to determine the optimal sequence for relocating storage locations and arrange the sequence of movement. Since this is at least NP-hard to solve, a heuristic algorithm was designed to solve this problem in several segments, enabling its application in practical scenarios with larger data scales to enhance the operational efficiency of automated storage systems. Computational experiments were conducted using various problem sizes to assess the performance of the proposed algorithm. Additionally, this study applied the proposed method to plan storage relocation for a large-scale automated AS/RS, which is operational at a computer hardware manufacturer in Taiwan, as a means to verify the feasibility and effectiveness of the method proposed in this research. © INTERNATIONAL JOURNAL OF INDUSTRIAL ENGINEERING.},
	author_keywords = {Automated Storage and Retrieval Systems; Heuristic Algorithm; Mathematical Programming; Multiple Input/Output Stations; Relocation Problem},
	keywords = {Automation; Computer control systems; Cost effectiveness; Digital storage; Information retrieval; Integer programming; Loading; Problem solving; Unloading; Warehouses; Automated storage and retrieval system; Critical issues; Heuristics algorithm; Input-output; Integer Program- ming; Multiple input/output station; Multiple inputs; Multiple loading; Relocation problem; Storage location; Heuristic algorithms},
