	pages = {404 - 407},
	doi = {10.1109/ICSSAS57918.2023.10331741},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181095086&doi=10.1109%2FICSSAS57918.2023.10331741&partnerID=40&md5=43251ec40235fd3ff52682dbaa2dd1aa},
