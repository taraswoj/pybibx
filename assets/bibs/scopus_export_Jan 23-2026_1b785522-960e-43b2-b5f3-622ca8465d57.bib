	title = {An analytical model to estimate AVS/RS energy consumption},
	year = {2019},
	journal = {IFAC-PapersOnLine},
	volume = {52},
	number = {13},
	pages = {24 - 29},
	doi = {10.1016/j.ifacol.2019.11.086},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078903033&doi=10.1016%2Fj.ifacol.2019.11.086&partnerID=40&md5=720a3a56ae81e560227b5936815bd12f},
	affiliations = {Politecnico di Torino, Turin, TO, Italy},
	abstract = {Automation systems to support warehouse activities are a topic largely debated. Critical decisions on the technology to be adopted and the basic system attributes must be taken in the design phase; to support designers, several methodologies have been defined to evaluate performance indicators such as throughput, cycle time and equipment utilization. Conversely, smaller attention has been paid so far in the estimation of the energy necessary to perform the scheduled activities. Nonetheless, this topic is gaining popularity as the impact of renewable energy sources is increasing and the adoption of complex energy grids is gaining popularity. This paper is aimed at proposing an analytical model to evaluate the energy consumption of Autonomous Vehicle Storage and Retrieval Systems (AVS/RS), which exhibit higher flexibility and lower energy consumption compared to the traditional AS/RS. The proposed model is able to estimate the average energy consumption by accounting for realistic criteria adopted to store and retrieve unit loads. The proposed approach is validated by comparing the analytical estimation to the output of a simulation model. © 2019, IFAC (International Federation of Automatic Control) Hosting by Elsevier Ltd. All rights reserved.},
	author_keywords = {Analytical and numerical modelling; Autonomous vehicle storage and retrieval system; Energy consumption modelling; Performance analysis; Warehouse automation},
	keywords = {Automation; Autonomous vehicles; Energy utilization; Information retrieval; Renewable energy resources; Warehouses; Analytical estimations; Autonomous vehicle storage and retrieval systems; Energy consumption modelling; Equipment utilization; Performance analysis; Performance indicators; Renewable energy source; Warehouse automation; Analytical models},
	editor = {Ivanov, D. and Dolgui, A. and Yalaoui, F.},
