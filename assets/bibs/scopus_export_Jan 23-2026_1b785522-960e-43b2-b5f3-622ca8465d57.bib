@CONFERENCE{Branisso2014137,
	author = {Branisso, Lucas Binhardi and Kato, Edilson Reis Rodrigues and Pedrino, Emerson Carlos and Morandin, Orides and Tsunaki, Roberto Hideaki},
	title = {A multi-agent system using fuzzy logic to increase AGV fleet performance in warehouses},
	year = {2014},
	journal = {Brazilian Symposium on Computing System Engineering, SBESC},
	pages = {137 - 142},
	doi = {10.1109/SBESC.2013.29},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84903527189&doi=10.1109%2FSBESC.2013.29&partnerID=40&md5=ea3a66603b82e15a193d6f3efac669cd},
	affiliations = {Universidade Federal de São Carlos, Sao Carlos, SP, Brazil; Universidade de São Paulo, Sao Paulo, SP, Brazil},
	abstract = {Market competition requires an ever increasing performance from warehouses. Coupled with information technologies, high automation levels are achieved. Such automation is seen in the use of AGVs for material handling. An important problem in AGV fleets is deciding what task should be assigned to each AGV. To tackle this problem, a multi-agent AGV system is proposed, which has three agents: an AGV agent, a Loading Point (LP) agent and a Storage Point (SP) agent. The AGV agent uses a Fuzzy system to decide what task it should take, and dispatch the AGV to the location of the task, using the A-star (A*) algorithm to find the shortest path to the task. The LP agent keeps a list of all available tasks in its corresponding loading point, such as a loading dock, and handles task requests from AGV agents. The SP agent manages a particular storage space, such as a rack section, and handles AGV requests for payloads stored in the rack or requests for free space. To validate the system, a warehouse operation was simulated and evaluated measuring the average task wait time, time to complete tasks and average jam time. Two other decision methods were used, First Come First Served (FCFS) and Contract Network (CNET), to compare with the Fuzzy method. Results show that the Fuzzy method enabled a greater average task wait time reduction than the other two decision methods, and also completed tasks in less time. © 2013 IEEE.},
	keywords = {Competition; Fuzzy logic; Information technology; Multi agent systems; Systems engineering; Warehouses; Decision method; First come first served; Fleet performance; High automation; Market competition; Material handling; Storage spaces; Warehouse operation; Loading},
	publisher = {IEEE Computer Society help@computer.org},
