	keywords = {Adaptive implementations; Automatic systems; Distribution centers; Flow diversions; Freight terminals; Freight volumes; Handling systems; High efficiencies; Linear models; Material handling systems; Multiple paths; New approaches; Non-linear flows; Numerical experiments; Operational planning; Optimizer; Probabilistic informations; Routing; Routing tables; Shortest paths; Simulation experiments; Time controls; Total shipments; Travel time; Computer simulation; Materials handling equipment; Telecommunication networks; Materials handling},
