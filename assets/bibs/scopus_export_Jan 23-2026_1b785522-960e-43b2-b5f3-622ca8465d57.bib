@CONFERENCE{Liu2024235,
	author = {Liu, Jun and Wang, Lei and Shen, Tao and Bi, Shuhui},
	title = {Fitness-Distance Balance based Symbiotic Organism Search Algorithm for Path Planning of Warehouse Systems},
	year = {2024},
	journal = {International Conference on Advanced Mechatronic Systems, ICAMechS},
	pages = {235 - 240},
	doi = {10.1109/ICAMechS63130.2024.10818720},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216925002&doi=10.1109%2FICAMechS63130.2024.10818720&partnerID=40&md5=d087c22662c631f1a1a66574bb248db3},
	affiliations = {University of Jinan, School of Electrical Engineering, Jinan, Shandong, China; Ltd., Jinan, Shandong, China},
	abstract = {The path planning of Automated Guided Vehicle (AGV) is a core focus of research in intelligent warehousing, with the primary objective of determining the shortest route that circumvents obstacles based on known starting and ending points. Many meta-heuristic search (MHS) algorithms have been applied in path planning, such as Genetic Algorithm (GA), Ant Colony Optimization (ACO) and so on. However, MHS algorithms face several limitations in path planning, including the risk of premature convergence to local optima, high demand for computational resources, and poor adaptability in dynamic environments etc. To address these issues, Symbiotic Organism Search (SOS) is applied in intelligent warehousing, and is improved by a Fitness-Distance Balance (FDB) method, named FDB-SOS algorithm. The FDB-SOS algorithm enhances the path planning process by dynamically adjusting search parameters, leading to improved search efficiency. Simulation experiments validate the effectiveness of the proposed method, showing that the FDB-SOS algorithm outperforms the traditional SOS algorithm in both path distance and running time, with an average reduction of 32.83% in path distance and 26.70% in running time. © 2024 IEEE.},
	author_keywords = {Automated Guided Vehicle (AGV); Fitness-Distance Balance (FDB); Intelligent Warehouse Systems; Path Planning Algorithms; Symbiotic Organism Search (SOS)},
	keywords = {Automatic guided vehicles; Genetic algorithms; Motion planning; Automated guided vehicle; Automated guided vehicles; Distance balance; Fitness-distance balance; Intelligent warehouse; Intelligent warehouse system; Path-planning algorithm; Symbiotic organism search; Symbiotics; Warehouse systems; Ant colony optimization},
	correspondence_address = {S. Bi; University of Jinan, School of Electrical Engineering, Jinan, China; email: cse_bish@ujn.edu.cn},
	publisher = {IEEE Computer Society},
	issn = {23250682},
	isbn = {9781728165301; 9781509053469; 9781538671740; 9781479963812; 9781467379960; 9781665417525; 9798350366204; 9781665463805; 9781479925193; 9781728134802},
	language = {English},
	abbrev_source_title = {Int. Conf. Adv. Mechatronic Sys., ICAMechS},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Henkel202410694,
	author = {Henkel, Christian and Toussaint, Marc and Hönig, Wolfgang},
	title = {GSRM: Building Roadmaps for Query-Efficient and Near-Optimal Path Planning Using a Reaction Diffusion System},
	year = {2024},
	journal = {IEEE International Conference on Intelligent Robots and Systems},
	pages = {10694 - 10701},
	doi = {10.1109/IROS58592.2024.10801293},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85216479571&doi=10.1109%2FIROS58592.2024.10801293&partnerID=40&md5=ef15af20d5723a2d2f5183f8a9ed1f0d},
	affiliations = {Robert Bosch GmbH, Gerlingen, Baden-Wurttemberg, Germany; Technische Universität Berlin, Berlin, Germany},
	abstract = {Mobile robots frequently navigate on roadmaps, i.e., graphs where edges represent safe motions, in applications such as healthcare, hospitality, and warehouse automation. Often the environment is quasi-static, i.e., it is sufficient to construct a roadmap once and then use it for any future planning queries. Roadmaps are typically used with graph search algorithm to find feasible paths for the robots. Therefore, the roadmap should be well-connected, and graph searches should produce near-optimal solutions with short solution paths while simultaneously be computationally efficient to execute queries quickly.We propose a new method to construct roadmaps based on the Gray-Scott reaction diffusion system and Delaunay triangulation. Our approach, GSRM, produces roadmaps with evenly distributed vertices and edges that are well-connected even in environments with challenging narrow passages. Empirically, we compare to classical roadmaps generated by 8-connected grids, probabilistic roadmaps (PRM, SPARS2), and optimized roadmap graphs (ORM). Our results show that GSRM consistently produces superior roadmaps that are well-connected, have high query efficiency, and result in short solution paths. © 2024 IEEE.},
	keywords = {Factory automation; Graph algorithms; Mobile robots; Motion planning; Query processing; Street traffic control; Future planning; Graph-search algorithms; Ie graphs; Near-optimal; Optimal path planning; Quasi-static; Reaction diffusion systems; Roadmap; Solution path; Warehouse automation; Robot programming},
	correspondence_address = {C. Henkel; Robert Bosch GmbH, Stuttgart, Germany; email: hec2le@bosch.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {21530858},
	isbn = {9781538680940; 9781665479271; 9781424402595; 9781728162126; 9781467317375; 0780319338; 1424409128; 9781665417143; 9781479999941; 0780308239},
	coden = {85RBA},
	language = {English},
	abbrev_source_title = {IEEE Int Conf Intell Rob Syst},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

