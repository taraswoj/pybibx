@CONFERENCE{Kittisares2024,
	author = {Kittisares, Sarin and Kobayashi, Yoshikazu and Kumagai, Taichi and Yasuda, Shinya and Yoshida, Hiroshi},
	title = {Multi-Robot Scheduling for Deadlock Avoidance Using Nonstop Areas},
	year = {2024},
	journal = {IECON Proceedings (Industrial Electronics Conference)},
	pages = {},
	doi = {10.1109/IECON55916.2024.10905455},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000897301&doi=10.1109%2FIECON55916.2024.10905455&partnerID=40&md5=94e826b47ed632c51f044c8cf5d1499c},
	affiliations = {NEC Corporation, Visual Intelligence Research Laboratories, Tokyo, Japan; NEC Corporation, Defense and Aeronautic Systems Division, Tokyo, Japan},
	abstract = {Warehouse automation has become an essential aspect of modern logistics management. A critical component of warehouse automation is the path finding algorithm, which is responsible for calculating the route for automated guided vehicles to navigate the warehouse. However, conventional single-agent path planning suffers from deadlocks, resulting in a significant reduction in throughput. On the other hand, optimal and complete multi-agent path finding algorithms are slow and computationally expensive, making them unsuitable for warehouses with multiple uncertainties that require constant replanning. In this paper, we propose a novel scheduling technique to avoid deadlocks by introducing nonstop areas based on the dynamics of vehicle intersections. We define critical areas in the warehouse as nonstop areas and prohibit robots from stopping and waiting within these areas. The robot’s reservation length is dynamically extended to ensure that it reserves the entire path through the nonstop area, preventing it from blocking other robots moving through the intersection in other directions. The optimal positions of the nonstop areas were determined in two steps: the placement step to find where the deadlock occurred, and the trimming step to remove the excess nonstop area tiles. Simulation results showed 100% deadlock prevention and significantly improved throughput with the inclusion of the proposed nonstop area. Moreover, the addition of the trimming step further increases the throughput up to 12.27%. © 2024 IEEE.},
	author_keywords = {deadlock avoidance; path planning; warehouse automation},
	keywords = {Automatic guided vehicles; Industrial robots; Intelligent robots; Motion planning; Multipurpose robots; Robot programming; % reductions; Automated guided vehicles; Critical component; Deadlock avoidance; Logistic management; Modern logistics; Multirobots; Path-finding algorithms; Single-agent; Warehouse automation; Trimming},
	correspondence_address = {S. Kittisares; Visual Intelligence Research Laboratories, NEC Corporation, Kawasaki, 1753 Shimonumabe, Nakahara-ku, Kanagawa, Japan; email: sarin-kittisares@nec.com},
	publisher = {IEEE Computer Society},
