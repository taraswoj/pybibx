	doi = {10.1007/s00170-016-9792-9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85006107069&doi=10.1007%2Fs00170-016-9792-9&partnerID=40&md5=9086b150ae6faa4ffab69bc5e0136eb7},
