@ARTICLE{Nurgat202132,
	author = {Nurgat, Zubeir A. and Alaboura, Dina and Aljaber, Rania and Mustafa, Omar and Lawrence, Myer and Mominah, Maher A. and Aljazairi, Abdulrazaq Sheikh and Al-Jedai, Ahmed Hamdan},
	title = {Real-World Experience of a Standalone Robotic Device for Batch Compounding of Small-Volume Parenteral Preparations},
