	pages = {1755 - 1760},
	doi = {10.1109/ICCES57224.2023.10192604},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85168133738&doi=10.1109%2FICCES57224.2023.10192604&partnerID=40&md5=f47d03ef2f95187a88edb2decc7334aa},
