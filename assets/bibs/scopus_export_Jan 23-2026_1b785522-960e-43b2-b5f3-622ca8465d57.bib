@CONFERENCE{Yao20251156,
	author = {Yao, Yao and Deng, Chuanzi and Shen, Qingfei and Tong, Wu and Fu, Chao and Zhou, Xin},
	title = {Assessment of AGV Safety Perception in Smart Warehouse},
	year = {2025},
	pages = {1156 - 1160},
	doi = {10.1109/ISCAIT64916.2025.11010363},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010214509&doi=10.1109%2FISCAIT64916.2025.11010363&partnerID=40&md5=b7ab972f5a6e06b433a2e0f424ac3149},
	affiliations = {National Institute of Metrology China, Advanced Measurement Engineering Center, Beijing, China},
	abstract = {The safety perception capabilities of Automated Guided Vehicles (AGVs) in dynamic warehouse environments are critical for collision-free operation. Existing safety assessment, however, rely heavily on fragmented manufacturer self-certification and lack standardized testing protocols, particularly for non-contact obstacle avoidance. To address this gap, this study proposes a laser point cloud-based framework for systematically assessing AGV safety perception performance across three dimensions: motion interaction, obstacle reflectivity, and spatial angle and distance perception. The methodology integrates calibrated laser point clouds with quantitative metrics to ensure reproducibility and industrial relevance. Experimental results confirmed the system's compliance with safety application requirements in smart warehouse. AGV's dynamic obstacle avoidance ability was assessed under varying speeds and motion modes, with minimum safe distance (MSD) as the key metric. The Obstacle reflectivity assessment quantified detection rates (DR) for objects with reflectivity ranging from 10% to 90%, while spatial angle and distance experiments evaluated field-of-view (FOV) coverage and boundary recognition accuracy. The proposed methodology not only standardizes AGV safety evaluation but also provides a robust foundation for AGV safety certification processes. © 2025 IEEE.},
	author_keywords = {Automated Guided Vehicle (AGV); Performance Assessment; Safety Perception},
	keywords = {Automatic guided vehicles; Collision avoidance; Laser safety; Reflection; Warehouses; Automated guided vehicle; Automated guided vehicles; Laser point; Perception capability; Performance assessment; Point-clouds; Safety perception; Spatial angle; Spatial distance; Vehicle safety; Safety testing},
