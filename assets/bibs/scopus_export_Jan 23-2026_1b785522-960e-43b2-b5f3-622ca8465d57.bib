@ARTICLE{Xie2023713,
	author = {Xie, Lin and Li, Hanyi and Luttmann, Laurin},
	title = {Formulating and solving integrated order batching and routing in multi-depot AGV-assisted mixed-shelves warehouses},
	year = {2023},
	journal = {European Journal of Operational Research},
	volume = {307},
	number = {2},
	pages = {713 - 730},
	doi = {10.1016/j.ejor.2022.08.047},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85138771527&doi=10.1016%2Fj.ejor.2022.08.047&partnerID=40&md5=fd93e71a077212d59abcdf7a955aa1c5},
	affiliations = {Leuphana Universität Lüneburg, Luneburg, Niedersachsen, Germany; Ltd, Beijing, Beijing, China},
	abstract = {Different retail and e-commerce companies are facing the challenge of assembling large numbers of time-critical picking orders that include both small-line and multi-line orders. To reduce unproductive picker working time as in traditional picker-to-parts warehousing systems, different solutions are proposed in the literature and in practice. For example, in a mixed-shelves storage policy, items of the same stock keeping unit are spread over several shelves in a warehouse; or automated guided vehicles (AGVs) are used to transport the picked items from the storage area to packing stations instead of human pickers. This is the first paper to combine both solutions, creating what we call AGV-assisted mixed-shelves picking systems. We model the new integrated order batching and routing problem in such systems as an extended multi-depot vehicle routing problem with both three-index and two-commodity network flow formulations. Due to the complexity of the integrated problem, we develop a novel variable neighborhood search algorithm to solve the integrated problem more efficiently. We test our methods with different sizes of instances, and conclude that the mixed-shelves storage policy is more suitable than the usual storage policy in AGV-assisted mixed-shelves systems for orders with different sizes of order lines (saving up to 62% on driving distances for AGVs). Our variable neighborhood search algorithm provides optimal solutions within an acceptable computational time. © 2022 The Author(s)},
	author_keywords = {AGV-assisted picking; Logistics; Mixed-shelves storage; Order batching; Routing},
	keywords = {Automatic guided vehicles; Learning algorithms; Optimization; Vehicle routing; Automated guided vehicle-assisted picking; Automated guided vehicles; Different sizes; Mixed-shelf storage; Neighborhood search algorithms; Order batching; Routings; Shelf storage; Storage policies; Variable neighborhood search; Warehouses},
	correspondence_address = {L. Xie; Leuphana University of Lüneburg, Universitätallee 1, Lüneburg, 21335, Germany; email: xie@leuphana.de},
