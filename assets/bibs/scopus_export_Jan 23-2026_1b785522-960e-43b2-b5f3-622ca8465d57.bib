	keywords = {Collision avoidance; Factory automation; Industrial plants; Mixed reality; Mobile agents; Motion planning; Multi agent systems; Multipurpose robots; Planning; Warehouses; Differential drive robots; Execution framework; Higher-order dynamics; Multi-robot systems; Multiple mobile robot; Recent researches; Scheduling and coordinations; Warehouse automation; Robot programming},
