@CONFERENCE{Herrero2024157,
	author = {Herrero, Elena Galbally and Jorda, Mikael and Rudolf, Sasha and Kaczkowski, Gareth and Loubser, Chris and Ozog, Stefan and Cordoba, Matt and Jothiravi, Mithun and Schabb, Dan and Berger, Geoff and Actor, Charlie and Ferrick, A. J. and Esses, Alberto and Thable, Gagan and Stevens, Dave and Lara, Chris and Shemyakin, Misha and Baitalmal, Ahmad and Walti, Chris},
	title = {Design and Control of a Climbing Robot for Warehouse Automation},
	year = {2024},
	journal = {Springer Proceedings in Advanced Robotics},
	volume = {31 SPAR},
	pages = {157 - 168},
	doi = {10.1007/978-3-031-64057-5_19},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85200335540&doi=10.1007%2F978-3-031-64057-5_19&partnerID=40&md5=ded3896a4f08dcc8b84ef70e81a4f134},
	affiliations = {Stanford University, Stanford, CA, United States; Mytra AI, San Francisco, United States},
	abstract = {Efficient vertical movement within warehouses is pivotal for optimizing material flow and storage. Current solutions, such as elevators, are often costly, static, and present a single point of failure. These systems hinder rapid changes in response to evolving needs and are prohibitively costly for small to medium enterprises. Autonomous robotic systems offer a promising solution for enabling free movement and storage of materials in 3 dimensions. However, most existing robotic solutions focus on XY plane movement or movement of small loads along the Z axis. This paper presents a novel helical drive mechanism and control algorithm that enable our robot – the Mytra Bot – to move in a 3D grid-like system of racks and lift payloads of more than 1000 kg. When lifting such heavy payloads, minimizing robot tilt is a primary safety concern. The proposed control algorithm draws inspiration from the field of grasping to synchronize the Mytra Bot’s degrees of freedom during vertical movement and achieve minimal tilt while following a desired velocity profile. The experimental results demonstrate the Mytra Bot’s capability to lift a 1360 kg pallet across 3 m of travel while maintaining a tilt below 0.5<sup>∘</sup> throughout the motion. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2024.},
	keywords = {Degrees of freedom (mechanics); Machine design; Warehouses; 'current; Autonomous robotic systems; Climbing robots; Design and control; Material Flow; Material storages; Single point; Small to medium enterprise; Vertical movement; Warehouse automation; Robots},
	correspondence_address = {E.G. Herrero; Stanford University, Stanford, United States; email: elenagal@stanford.edu},
