@CONFERENCE{Witczak20191914,
	author = {Witczak, Marcin and Majdzik, Paweł and Stetter, Ralf and Lipiec, Bogdan},
	title = {Multiple AGV fault-tolerant within an agile manufacturing warehouse},
	year = {2019},
	journal = {IFAC-PapersOnLine},
	volume = {52},
	number = {13},
	pages = {1914 - 1919},
	doi = {10.1016/j.ifacol.2019.11.482},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85078909272&doi=10.1016%2Fj.ifacol.2019.11.482&partnerID=40&md5=796627b6939e7ab56ca35c7d91b6bee6},
	affiliations = {Uniwersytet Zielonogórski, Institute of Control and Computation Engineering, Zielona Gora, LB, Poland; Hochschule Ravensburg-Weingarten, Faculty of Mechanical Engineering, Weingarten, Baden-Wurttemberg, Germany; Steinbeis Transfer Center Automotive Systems, Ravensburg, Germany},
	abstract = {The current trend towards Industry 4.0 leads to several important aspects that concern future warehouse systems. The holistic digitalization efforts behind this trend may enable sustainable and resilient processes within warehouses and may increase their agility, but require elaborate control and diagnosis systems. This paper concentrates on one prominent means for increasing the agility - the employment of multiple automated guided vehicles (AGVs). Due to the complexity of a system with multiple AGVs, model predictive control (MPC) algorithms are required for effective and efficient operation. In industrial reality, uncertainties cannot be avoided, it is therefore highly desirable that these algorithms can handle such uncertainties and minor inconsistencies. The precedent necessities led to a strategy based on a fault-tolerant control framework, which is based on max-plus algebra with a model predictive control scheme. The applicability of this strategy is validated on the example of the feedings system of an high-bay warehouse. © 2019, IFAC (International Federation of Automatic Control) Hosting by Elsevier Ltd. All rights reserved.},
