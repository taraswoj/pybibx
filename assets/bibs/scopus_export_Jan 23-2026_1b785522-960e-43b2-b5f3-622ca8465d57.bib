@CONFERENCE{Berx2021280,
	author = {Berx, Nicole and Pintelon, Liliane M.A. and Decré, Wilm},
	title = {Psychosocial impact of collaborating with an autonomous mobile robot: Results of an exploratory case study},
	year = {2021},
	journal = {ACM/IEEE International Conference on Human-Robot Interaction},
	pages = {280 - 282},
	doi = {10.1145/3434074.3447176},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85102764866&doi=10.1145%2F3434074.3447176&partnerID=40&md5=ef6b0d58a94f835ee56d6061ac3b22a0},
	affiliations = {KU Leuven, Mechanical Engineering, Leuven, Vlaams-Brabant, Belgium},
	abstract = {The study was part of a confidential pilot project concerning the introduction of Autonomous Mobile Robots in an order picking process. The study assesses the impact of working with an AMR on logistics workers (hereinafter referred to as 'operators'). Two research questions were investigated. First, does working with an AMR lead to increased psychosocial workload? And second, what is the perception of the operators working with an AMR? Very little research, outside a lab context, has been done so far on the impact of working with an AMR. This study contributes to the understanding of the impact of working with robots, outside the lab in an industrial setting. The results of this study can be summarized as follows: 1) working with an AMR does not lead to extra psychosocial workload and 2) there is a positive perception and attitude versus working with an AMR. © 2021 ACM.},
