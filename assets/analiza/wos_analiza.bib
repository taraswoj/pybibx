@inproceedings{ WOS:000469786300118,
Author = {Wu, Yujian and Huang, Lei},
Book-Group-Author = {ACM},
Title = {Design of Dynamic Surveillance System for Port Bulk Cargo Entering and
   Leaving the Warehouse Based on RFID Technology},
Booktitle = {PROCEEDINGS OF 2018 THE 2ND INTERNATIONAL CONFERENCE ON COMPUTER SCIENCE
   AND ARTIFICIAL INTELLIGENCE (CSAI 2018) / 2018 THE 10TH INTERNATIONAL
   CONFERENCE ON INFORMATION AND MULTIMEDIA TECHNOLOGY (ICIMT 2018)},
Year = {2018},
Pages = {615-619},
Note = {2nd International Conference on Computer Science and Artificial
   Intelligence (CSAI) / 10th International Conference on Information and
   Multimedia Technology (ICIMT), Shenzhen, PEOPLES R CHINA, DEC 08-10,
   2018},
Abstract = {Bulk cargo is the most important cargo category in China's port
   transportation industry, it mainly stores in the warehouse of the port.
   However, at present, the informatization level of many ports in China is
   not high. Most port enterprises still use the way of on-site command for
   the management of bulk cargoes entering and leaving the warehouse. This
   kind of human prevention controling is not only inefficient and labor
   cost is too high, but also easy to make mistakes and it is greatly
   effected by the weather. The most important thing is to increase the
   risk of goods being stolen and the goods entering the wrong warehouse.
   Therefore, designing a bulk cargo entering and leaving the warehouse
   system that can effectively avoid risks is particularly important for
   improving port information and reducing cargo risks. This paper combines
   RFID technology to design a dynamic surveillance system for bulk cargo
   entering and leaving the warehouse. The system organically combines the
   IoT hardware device with the port production service system. The IoT
   hardware is responsible for setting the virtual card port. The
   production service system is responsible for receiving and displaying
   the data obtained by the Internet of Things in real time. The two
   systems interact with each other through the WebService interface, thus
   realizing the automation of bulk cargo entering and leaving the
   warehouse, not only reducing the risk of port cargo theft, entering the
   wrong warehouse, but also improving the information level of the port,
   which has strong practicability and operability.},
