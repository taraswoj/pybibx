@article{ WOS:001522842100003,
Author = {Yang, Shuo and Song, Shuai and Song, Ran and Cheng, Jiyu and Li, Yibin
   and Zhang, Wei},
Title = {Learning packing-and-unpacking synergistic policy via LLM-guided DRL for
   robust online robotic packing},
Journal = {ADVANCED ENGINEERING INFORMATICS},
Year = {2025},
Volume = {68},
Number = {A},
Month = {NOV},
Abstract = {Online robotic packing facilitates various applications within the
   logistics industry, attracting increasing attentions of developing
   robotic packing system for logistic scenarios. Typically, the online
   robotic packing aims to pick items one by one and then pack them into a
   container with as high space utilization as possible. In most studies,
   the online robotic packing is modeled as an Online 3D Bin Packing
   Problem (3D-BPP), which is notoriously NP-hard due to the online setting
   that only the current item is observable. Currently, the heuristic
   methods and deep reinforcement learning (DRL) methods are two primary
   approaches for online 3D-BPP. Nonetheless, these methods are still
   inferior to human packers when finishing packing tasks in logistics
   applications. One important reason is that humans have the ability to
   correct mistakes: when some items have not been packed appropriately,
   human packers will unpack them from the container and then arrange these
   items in more reasonable positions. Motivated by the unpacking
   experience of human packers, we rethink the pipeline for online 3D-BPP
   and present a packing-and-unpacking synergistic network (PUSNet) that
   integrates DRL and large language model (LLM) guidances. Through
   extensive experiments, PUSNet is demonstrated the state-of-the-art
   robotic packing pipeline. Moreover, the robotic packing system built
   upon PUSNet exhibits reliable packing performance in real-world
   logistics scenarios, in terms of both the space utilization and packing
   stability.},
