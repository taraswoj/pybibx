Year = {2018},
Volume = {81},
Pages = {97-104},
Month = {DEC},
Abstract = {In this paper we present an online supervisory control approach, based
   on limited lookahead policy, that is amenable for the control of
   multi-agent discrete-event systems. We then apply this online control
   scheme to model and control a warehouse automation system served by
   multiple mobile robots; the effectiveness of this scheme is demonstrated
   through a case study. Moreover, we build an experiment testbed for
   testing the validity of our proposed method with implementation on real
   robots.},
