Title = {A study of cloud based maintenance system architecture for warehouse
   automation equipment},
Booktitle = {PROCEEDINGS 2016 5TH IIAI INTERNATIONAL CONGRESS ON ADVANCED APPLIED
   INFORMATICS IIAI-AAI 2016},
Year = {2016},
Pages = {985-990},
Note = {5th IIAI International Congress on Advanced Applied Informatics
   (IIAI-AAI), Kumamoto, JAPAN, JUL 10-14, 2016},
Abstract = {Recently, there is a growing need for logistics companies to have
   world-class competitiveness to survive in the increased competition and
   globalization. Due to the rapid advancement of technology and growing
   requests of customers, companies are applying various methods to address
   new challenges. In particular, the operations management of warehouse
   equipment has emerged as a critical area with the increased adoption of
   automated equipment, which has been reducing the operation costs of
   companies. However, in many cases, the efficiency of equipment operation
   is much less than expected due to inappropriate management of automated
   equipment such as maintenance delay, inability to measure life
   expectancy of equipment, inaccuracy of management, and delay in
   equipment updates. This study thus proposes a cloud computing based
   maintenance system architecture that provides continuous monitoring of
   equipment, quick maintenance work processing, management of maintenance
   information, prediction of equipment defects, and maintenance education
   and support.},
