@inproceedings{ WOS:000709774300030,
Author = {Karoly, I, Artur and Elek, Renata Nagyne and Haidegger, Tamas and
   Galambos, Peter},
Book-Group-Author = {IEEE},
Title = {Moving Obstacle Segmentation with an Optical Flow-based DNN: an
   Implementation Case Study},
