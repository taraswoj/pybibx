@article{ WOS:000487833400077,
Author = {Tan, Yaxin and Li, Jing and Li, Yufeng and Huang, Yufeng},
Title = {Study on the response of sprinkler system in logistics warehouse under
   the influence of the hollow floorboard},
Journal = {CASE STUDIES IN THERMAL ENGINEERING},
Year = {2019},
Volume = {14},
Month = {SEP},
Abstract = {The domestic logistics industry has developed rapidly, and then a large
   number of logistics warehouses adopting mezzanine shelving system have
   emerged. Aiming at the influence of the hollowed floorboard structure of
   the mezzanine shelving system on the fire hazard of the logistics
   warehouse, the paper analyzes the smoke temperature under the impact of
   the hollowing rate of the mezzanine shelving system through the fire
   smoke spread process, and evaluates the hollowing rate of 5\%, 10\%,
   15\%, 20\%, 25\%, 30\%, and 50\%. Through FDS (Fire Dynamics Simulator)
   simulation study, the results verify that along with the decrease of the
   hollowing rate and the increase of the distance, the smoke temperature
   gradually reduces; Furthermore, the functional relationship between
   respond temperature of the automatic sprinkler system and the hollowing
   rate was fitted by the functional relationshipY = a(1 - e(-bx)). The R
   value of the position which directly above the fire source was about
   0.99, and the fitting result was desirable. The research results have
   certain practical value for the design of automatic sprinkler system and
   fire risk analysis of logistics warehouses with mezzanine shelving
   system.},
