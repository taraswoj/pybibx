@article{ WOS:000690377100001,
Author = {Yan, Tingting},
Title = {Positioning of logistics and warehousing automated guided vehicle based
   on improved LSTM network},
Journal = {INTERNATIONAL JOURNAL OF SYSTEM ASSURANCE ENGINEERING AND MANAGEMENT},
