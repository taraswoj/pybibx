@article{ WOS:000321889500015,
Author = {Marchet, Gino and Melacini, Marco and Perotti, Sara and Tappia, Elena},
Title = {Development of a framework for the design of autonomous vehicle storage
   and retrieval systems},
Journal = {INTERNATIONAL JOURNAL OF PRODUCTION RESEARCH},
Year = {2013},
Volume = {51},
Number = {14},
Pages = {4365-4387},
Month = {JUL 1},
Abstract = {In today's competitive environment with increasingly faster deliveries
   and smaller order sizes, material handling providers are progressively
   developing new solutions. A more recent development in automated
   material-handling technology for unit load storage and retrieval is the
   autonomous vehicle storage and retrieval system (AVS/RS). The paper
   investigates the main design trade-offs for this new solution using
   simulation, and proposes a comprehensive design framework. Using data
   from a recently implemented AVS/RS, the application of the proposed
   framework is presented and the key design differences between the two
   types of AVS/RS configuration (i.e. tier-captive versus tier-to-tier)
   are identified.},
