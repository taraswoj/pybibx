@article{ WOS:001106458600022,
Author = {Co, Maricel and Sham, Rohana and Ahmad, Noraini and Acesor, Steve},
Title = {Warehouse Automation Implementation Environment: Case of Central
   Warehouse Management in Mali, West Africa},
Journal = {ENVIRONMENT-BEHAVIOUR PROCEEDINGS JOURNAL},
Year = {2023},
