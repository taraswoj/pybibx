@inproceedings{ WOS:001313824900019,
Author = {Herrero, Elena Galbally and Jorda, Mikael and Rudolf, Sasha and
   Kaczkowski, Gareth and Loubser, Chris and Ozog, Stefan and Cordoba, Matt
   and Jothiravi, Mithun and Schabb, Dan and Berger, Geoff and Actor,
   Charlie and Ferrick, A. J. and Esses, Alberto and Thable, Gagan and
   Stevens, Dave and Lara, Chris and Shemyakin, Misha and Baitalmal, Ahmad
   and Walti, Chris},
Editor = {Lenarcic, J and Husty, M},
Title = {Design and Control of a Climbing Robot for Warehouse Automation},
Booktitle = {ADVANCES IN ROBOT KINEMATICS 2024, ARK 2024},
