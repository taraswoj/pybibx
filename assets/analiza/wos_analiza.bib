@article{ WOS:001280830200003,
Author = {Ellithy, Kareim and Salah, Mariam and Fahim, Irene S. and Shalaby,
   Raafat},
Title = {AGV and Industry 4.0 in warehouses: a comprehensive analysis of existing
   literature and an innovative framework for flexible automation},
Journal = {INTERNATIONAL JOURNAL OF ADVANCED MANUFACTURING TECHNOLOGY},
