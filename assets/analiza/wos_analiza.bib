Title = {A Mathematical Modeling for Loading/Unloading Scheduling Problem of
   Warehouse in Lithium Battery Formation Automatic Line},
Booktitle = {INTERNATIONAL CONFERENCE ON AUTOMATION, MECHANICAL AND ELECTRICAL
   ENGINEERING (AMEE 2015)},
Year = {2015},
Pages = {114-122},
Note = {International Conference on Automation, Mechanical and Electrical
   Engineering (AMEE), Phuket, THAILAND, JUL 26-27, 2015},
Abstract = {Loading/unloading scheduling is one of the main factors affecting the
   efficiency of automated warehouse. Because the cargoes in the warehouse
   of lithium battery formation automatic line have time sequence according
   to charging/discharging process, a mixed-scheduling mode of warehouse
   operation is proposed in this paper. And then a time model is built to
   calculate the time for transferring cargoes between different locations,
   which transferring optimization problem of warehouse scheduling into a
   similar to the travelling salesman problem (TSP). A mathematical model
   is built for optimization problem and ant colony algorithm is used to
   solve the model. The simulation results show that this method can
   effectively applied to the scheduling optimization for loading/unloading
   operation of warehouse in lithium battery formation automatic line and
   increase the job efficiency of stacker.},
