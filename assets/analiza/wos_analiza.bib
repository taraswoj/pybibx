@article{ WOS:000670691800001,
Author = {Aleotti, Jacopo and Baldassarri, Alberto and Bonfe, Marcello and
   Carricato, Marco and Chiaravalli, Davide and Di Leva, Roberto and
   Fantuzzi, Cesare and Farsoni, Saverio and Innero, Gino and Lodi Rizzini,
   Dario and Melchiorri, Claudio and Monica, Riccardo and Palli, Gianluca
   and Rizzi, Jacopo and Sabattini, Lorenzo and Sampietro, Gianluca and
   Zaccaria, Federico},
Title = {Toward Future Automatic Warehouses: An Autonomous Depalletizing System
   Based on Mobile Manipulation and 3D Perception},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2021},
Volume = {11},
Number = {13},
Month = {JUL},
Abstract = {This paper presents a mobile manipulation platform designed for
   autonomous depalletizing tasks. The proposed solution integrates machine
   vision, control and mechanical components to increase flexibility and
   ease of deployment in industrial environments such as warehouses. A
   collaborative robot mounted on a mobile base is proposed, equipped with
   a simple manipulation tool and a 3D in-hand vision system that detects
   parcel boxes on a pallet, and that pulls them one by one on the mobile
   base for transportation. The robot setup allows to avoid the cumbersome
   implementation of pick-and-place operations, since it does not require
   lifting the boxes. The 3D vision system is used to provide an initial
   estimation of the pose of the boxes on the top layer of the pallet, and
   to accurately detect the separation between the boxes for manipulation.
   Force measurement provided by the robot together with admittance control
   are exploited to verify the correct execution of the manipulation task.
   The proposed system was implemented and tested in a simplified
   laboratory scenario and the results of experimental trials are reported.},
