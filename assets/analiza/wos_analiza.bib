@inproceedings{ WOS:001360252300023,
Author = {Agrawal, Tarun Kumar and Hanson, Robin and Sultans, Farook Abdullah and
   Johansson, I, Mats and Andersson, Dan and Stefansson, Gunnar and
   Katsela, Konstantina and Browne, Michael},
Editor = {Alfnes, E and Romsdal, A and Strandhagen, JO and VonCieminski, G and Romero, D},
Title = {Automating Loading and Unloading for Autonomous Transport: Identifying
   Challenges and Requirements with a Systems Approach},
Booktitle = {ADVANCES IN PRODUCTION MANAGEMENT SYSTEMS. PRODUCTION MANAGEMENT SYSTEMS
   FOR RESPONSIBLE MANUFACTURING, SERVICE, AND LOGISTICS FUTURES, APMS
