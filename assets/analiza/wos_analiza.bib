@inproceedings{ WOS:001332800800238,
Author = {Pawale, Satyam and Kunder, Harish and Prajwal, P. and Shriprasad, D. J.
   and Vinay, S.},
Book-Group-Author = {IEEE},
Title = {Warehouse Inventory Management: Drone-Powered Semi-Automation with
   Raspberry Pi and Network Integration},
Booktitle = {10TH INTERNATIONAL CONFERENCE ON ELECTRONICS, COMPUTING AND
   COMMUNICATION TECHNOLOGIES, CONECCT 2024},
Series = {IEEE International Conference on Electronics Computing and Communication
   Technologies},
Year = {2024},
Note = {10th IEEE International Conference on Electronics, Computing and
   Communication Technologies (IEEE CONECCT), Indian Inst Sci, Bangalore,
   INDIA, JUL 12-14, 2024},
Abstract = {Economic growth and the rapid expansion of e-commerce globally are
   driving the increasing demand for smart warehouses with advanced
   inventory management systems. The integration of IoT with aerial
   drone-based inventory mapping has recently emerged as a pivotal
   development, offering safer and faster access to inventory across
   various warehouse scales. This study introduces a semi-automated
   inventory management methodology within warehouse settings, leveraging
   the synergy of Raspberry Pi, Pixhawk flight controllers, and an array of
   sensors. The proposed system captures and transmits real-time data using
   AI and networking technologies, empowering with SOM, warehouse managers
   to optimize inventory tracking and storage conditions. By recognizing
   the essential role of human engagement, this study bridges the gap
   between cutting-edge technology and human expertise, fostering a
   collaborative and efficient warehouse environment.},
