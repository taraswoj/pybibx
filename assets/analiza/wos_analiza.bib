@article{ WOS:000415507000005,
Author = {Molla-Descals, Alejandro and Gil-Saura, Irene and Ruiz-Molina,
   Maria-Eugenia},
Title = {Automation of Warehouse Management and Assortment in the Distribution of
   Durable Goods: An Analysis for the Ceramics and Building Supplies
   Industry in Spain},
Journal = {JOURNAL OF MARKETING CHANNELS},
Year = {2009},
Volume = {16},
Number = {4},
Pages = {375-390},
Abstract = {The introduction of information and communication technologies can be a
   source of competitive advantages for the retailer, even if at
   significant cost. In the present work we try to identify the factors
   that characterize companies that invest in these technologies to
   automate warehouse management and, in particular, the relation between
   the degree of automation and the retail assortment. In order to achieve
   this aim, we consider a sample of distributors of ceramics and building
   supplies in Spain. The results suggest that warehouse management
   automation is related to the depth and breadth of the products carried
   in the retail assortment.},
