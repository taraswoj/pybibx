@article{ WOS:000346566100006,
Author = {Marchet, Gino and Melacini, Marco and Perotti, Sara},
Title = {Investigating order picking system adoption: a case-study-based approach},
Journal = {INTERNATIONAL JOURNAL OF LOGISTICS-RESEARCH AND APPLICATIONS},
Year = {2015},
Volume = {18},
Number = {1},
Pages = {82-98},
Month = {JAN 2},
Abstract = {The aim of this research is to investigate the state of the art in the
   adoption of order picking systems (OPS) and provide a broad empirical
   analysis built on a cross-section of 40 Italian distribution or factory
   warehouses. The analysis is based on multiple case studies.
   Semi-structured interviews were conducted with management at leading
   companies operating in different industries, and results are discussed
   with reference to the literature. The study provides an insight into the
   types of OPS adopted at distribution or factory warehouses. Results show
   the OPS type implemented, their automation level, and the main
   information and communication technology systems in place to support
   picking activities. The findings offer interesting views on how and
   where the different types of OPS may be appropriate based on contextual
   requirements.The paper fulfils an identified need for in-depth case
   studies on OPS focusing on their adoption level and implementation
   process (i.e. motivations and barriers to adoption) in warehouses and
   suggests areas for future research.},
