@inproceedings{ WOS:001290469200119,
Author = {Bhat, Akhilesh and Kai, Natsuki and Suzuki, Takayuki and Shiroshima,
   Takahiro and Yoshida, Hiroshi},
Book-Group-Author = {IEEE},
Title = {Fake Obstacle Generation-based Pallet Alignment for Forklifts},
Booktitle = {2024 16TH INTERNATIONAL CONFERENCE ON COMPUTER AND AUTOMATION
   ENGINEERING, ICCAE 2024},
Series = {International Conference on Computer and Automation Engineering},
Year = {2024},
Pages = {676-680},
Note = {16th International Conference on Computer and Automation Engineering
   (ICCAE), Melbourne, AUSTRALIA, MAR 14-16, 2024},
Abstract = {Warehouse receiving capacity is one of the major bottlenecks in supply
   chain. Due to shortages of skilled labor and insufficient material
   handling equipment, a receiving company can face several hours of delay.
   Autonomous forklifts can compensate for the above issues with efficient
   material handling capabilities and longer deployment times. However,
   this requires accurate navigation, control and docking algorithms to
   safely engage pallets and transport them.
   This paper proposes a novel strategy for efficiently aligning a forklift
   to a pallet by generating fake obstacles near the goal and selecting
   from via-points generated depending on relative position of the
   forklift. In addition, we describe a simple state machine architecture
   that helps funnel the forklift into position using this strategy, and
   present simulation results.},
